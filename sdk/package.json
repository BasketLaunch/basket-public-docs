{
  "name": "@basketlaunch/sdk",
  "version": "0.2.2",
  "description": "Official mainnet integration SDK for BASKET Solana basket tokens",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "keywords": [
    "solana",
    "basket",
    "trading",
    "launchpad",
    "pumpfun",
    "raydium"
  ],
  "homepage": "https://basketlaunch.fun/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BasketLaunch/basket-public-docs.git",
    "directory": "sdk"
  },
  "bugs": {
    "url": "https://github.com/BasketLaunch/basket-public-docs/issues"
  },
  "license": "GPL-3.0",
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@solana/kit": "^8.3.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "buffer": "6.0.3",
    "bn.js": "^5.2.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "typescript": "^7.0.2"
  }
}
